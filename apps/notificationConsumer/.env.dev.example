# Molde de variáveis do notificationConsumer em DEV
# Copie para .env.dev (na raiz deste serviço) e preencha (não versionar).
# Credenciais devem ser as mesmas de infra/.env.dev.
# Rodar: sem APP_ENV o serviço usa DEV por padrão.

# Fila de mensagens ACTIVEMQ (porta AMQP 1.0 do infra)
ACTIVEMQ_URL=amqp://localhost:5672
ACTIVEMQ_USER=admin
ACTIVEMQ_PASS=sua_senha_aqui
FILA_NOTIFICACAO=fila.ponto.notificacao
