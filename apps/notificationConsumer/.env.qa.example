# Molde de variáveis do notificationConsumer em QA
# Copie para .env.qa (na raiz deste serviço) e preencha (não versionar).
# Credenciais devem ser as mesmas de infra/.env.qa.
# Rodar: $env:APP_ENV = "qa"

# Fila de mensagens ACTIVEMQ (porta AMQP 1.0 do infra)
ACTIVEMQ_URL=amqp://localhost:5672
ACTIVEMQ_USER=seu_usuario_aqui
ACTIVEMQ_PASS=sua_senha_aqui
FILA_NOTIFICACAO=fila.ponto.notificacao
