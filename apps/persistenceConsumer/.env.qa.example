# Molde de variáveis do persistenceConsumer em QA
# Copie para .env.qa (na raiz deste serviço) e preencha (não versionar).
# Credenciais e portas devem ser as mesmas de infra/.env.qa.
# Rodar: defina APP_ENV=qa (no IntelliJ: Run Configuration > Environment variables: APP_ENV=qa)

# ATENÇÃO: DB_PASS precisa ser a senha com que o banco foi criado (infra/.env.qa na primeira subida).
# Trocar a senha só no .env não muda o banco; veja a nota no infra/.env.qa.example.
# Banco de dados (PostgreSQL do infra)
DB_URL=jdbc:postgresql://localhost:5432/ponto_qa_db
DB_USER=qa_user
DB_PASS=sua_senha_aqui
SHOW_SQL=false

# Fila de mensagens ACTIVEMQ (porta AMQP 1.0 do infra)
ACTIVEMQ_URL=amqp://localhost:5673
ACTIVEMQ_USER=admin
ACTIVEMQ_PASS=sua_senha_aqui
