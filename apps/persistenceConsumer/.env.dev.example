# Molde de variáveis do persistenceConsumer em DEV
# Copie para .env.dev (na raiz deste serviço) e preencha (não versionar).
# Credenciais e portas devem ser as mesmas de infra/.env.dev.
# Rodar: sem APP_ENV o serviço usa DEV por padrão.

# Banco de dados (PostgreSQL do infra)
DB_URL=jdbc:postgresql://localhost:5433/ponto_dev_db
DB_USER=dev_user
DB_PASS=sua_senha_aqui
SHOW_SQL=true

# Fila de mensagens ACTIVEMQ (porta AMQP 1.0 do infra)
ACTIVEMQ_URL=amqp://localhost:5672
ACTIVEMQ_USER=admin
ACTIVEMQ_PASS=admin
