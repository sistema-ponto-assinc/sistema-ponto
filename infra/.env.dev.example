# Molde de variáveis do ambiente DEV
# Copie para .env.dev e preencha com seus dados locais (não versionar).
# Em DEV o banco relacional é o PostgreSQL do compose (porta 5433 para não conflitar com QA).
# Subir infra: docker compose --env-file .env.dev up -d
# Subir infra + serviços (build a partir do código): docker compose --env-file .env.dev --profile app up -d --build

ENV_NAME=dev

# Fila de mensagens ACTIVEMQ/AMQP
# Porta AMQP 1.0 (protocolo oficial dos serviços)
ACTIVEMQ_AMQP_PORT=5672
# Porta da interface web do ActiveMQ
ACTIVEMQ_UI_PORT=8161
ACTIVEMQ_USER=admin
ACTIVEMQ_PASS=admin

# ATENÇÃO: usuário e senha do banco só são aplicados na PRIMEIRA subida, com o volume vazio.
# Depois ficam gravados no volume: mudar este arquivo não muda a senha e gera
# 'password authentication failed'. Para recriar com os valores atuais, remova os volumes (apaga os dados de DEV; schema e seed são recriados pelo db/init):
#   docker compose --env-file .env.dev --profile app down -v
# Banco de dados (PostgreSQL)
# Porta diferente de QA para permitir os dois ambientes na mesma máquina
DB_PORT=5433
DB_USER=dev_user
DB_PASS=sua_senha_aqui
DB_NAME=ponto_dev_db

# Serviços da aplicação (só com --profile app)
# Porta do persistenceConsumer
APP_PORT=8080
