# Molde de variáveis do ambiente QA
# Copie para .env.qa e preencha (não versionar).
# Em QA o banco relacional é PostgreSQL persistido em volume Docker, compartilhado por todos os serviços.
# Subir infra: docker compose --env-file .env.qa up -d
# Subir infra + serviços (build a partir do código): docker compose --env-file .env.qa --profile app up -d --build

ENV_NAME=qa

# ATENÇÃO: usuário e senha do banco só são aplicados na PRIMEIRA subida, com o volume vazio.
# Depois ficam gravados no volume: mudar este arquivo não muda a senha e gera
# 'password authentication failed'. Para recriar com os valores atuais, remova os volumes (APAGA OS DADOS DE QA; schema e seed são recriados pelo db/init):
#   docker compose --env-file .env.qa --profile app down -v
# Banco de dados (PostgreSQL)
DB_PORT=5432
DB_USER=qa_user
DB_PASS=sua_senha_aqui
DB_NAME=ponto_qa_db

# Fila de mensagens ACTIVEMQ/AMQP
# Portas diferentes de DEV para permitir os dois ambientes na mesma máquina
# Porta AMQP 1.0 (protocolo oficial dos serviços)
ACTIVEMQ_AMQP_PORT=5673
# Porta da interface web do ActiveMQ
ACTIVEMQ_UI_PORT=8162
# Usuário deve ser "admin": a imagem só dá acesso ao console para o grupo admins=admin
ACTIVEMQ_USER=admin
ACTIVEMQ_PASS=sua_senha_aqui

# Serviços da aplicação (só com --profile app)
# Porta do persistenceConsumer
APP_PORT=8081
