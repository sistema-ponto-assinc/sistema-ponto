# Molde de Variáveis para rodar o Docker Compose localmente
# Copie este arquivo, renomeie para .env.dev/qa e preencha com seus dados locais.
# Tenha em mente que este arquivo não deve ser versionado, pois contém dados sensíveis.
# Tenha em mente que em dev o banco de dados é em memoria sempre. Em qa o banco de dados é persistido em disco/docker volume.

# banco de dados
ENV_NAME=dev
DB_PORT=5432
DB_USER=dev_user
DB_PASS=sua_senha_aqui
DB_NAME=ponto_dev_db

# Fila de mensagens ACTIVEMQ/AMQP
ACTIVEMQ_PORT=61616
ACTIVEMQ_UI_PORT=8161 # Porta para acessar a interface web do ActiveMQ
ACTIVEMQ_USER=admin
ACTIVEMQ_PASS=admin